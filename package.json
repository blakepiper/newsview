{
  "name": "newsview",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.18.0 || >=26.0.0",
    "npm": ">=11"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "qs": "6.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/proxy.cjs",
    "build": "tsc -b && vite build && node scripts/compress-assets.cjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs tests/*.test.ts",
    "test:unit": "node --test tests/*.test.cjs tests/*.test.ts",
    "test:smoke": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "5.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.5",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "description": "A quiet, self-hosted news display for an always-on screen."
}
